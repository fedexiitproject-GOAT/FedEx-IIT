<templates xml:space="preserve">
  <t t-name="fedex_repository.Dashboard">
    <main class="o_fedex_dashboard">
      <section class="fedex-hero p-4 p-lg-5 mb-4">
        <div class="position-relative" style="z-index:1">
          <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
            <span class="fedex-pill"><i class="fa fa-flask"/> RESEARCH OPERATIONS</span>
            <span class="small" style="color:rgba(255,255,255,.8)">FedEx Repository</span>
          </div>
          <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-end gap-4">
            <div>
              <h1 class="mb-2">Research, connected.</h1>
              <p class="mb-0">A clear view of projects, people, milestones and research outcomes across the FedEx ecosystem.</p>
            </div>
            <div class="d-flex flex-wrap gap-2">
              <button class="btn btn-light" t-on-click="()=>open('fedex_repository.action_projects')"><i class="fa fa-folder-open me-2"/>Browse projects</button>
              <button class="btn btn-outline-light" t-on-click="()=>open('fedex_repository.action_fedex_global_search')"><i class="fa fa-search me-2"/>Global search</button>
            </div>
          </div>
        </div>
      </section>

      <div t-if="state.error" class="alert alert-warning" role="alert"><i class="fa fa-exclamation-triangle me-2"/>The dashboard metrics could not be loaded. Check your access rights and server logs, then refresh the page.</div>
      <section class="row g-3 mb-4" aria-label="Repository key performance indicators">
        <t t-foreach="[[ 'Active Projects','active_projects','fa-folder-open','fedex_repository.action_projects','purple'],['Nearing Completion','nearing','fa-hourglass-half','fedex_repository.action_nearing_projects','orange'],['Missing Documents','missing_documents','fa-file-text-o','fedex_repository.action_pending_documents','orange'],['Overdue Milestones','overdue_milestones','fa-calendar-times-o','fedex_repository.action_dashboard_overdue_milestones','purple'],['Total Students','students','fa-users','fedex_repository.action_students','purple'],['Active Interns','active_interns','fa-graduation-cap','fedex_repository.action_dashboard_active_interns','orange']]" t-as="card" t-key="card[1]">
          <div class="col-12 col-sm-6 col-xl-4">
            <button t-att-class="'card fedex-kpi ' + (card[4] === 'orange' ? 'fedex-kpi-orange' : '')" t-on-click="()=>open(card[3])" t-att-aria-label="'Open report: ' + card[0]">
              <div class="fedex-kpi-icon"><i t-att-class="'fa ' + card[2]"/></div>
              <div class="fedex-kpi-label"><t t-esc="card[0]"/></div>
              <div class="fedex-kpi-value mt-1"><t t-esc="state.data[card[1]] ?? 0"/></div>
              <div class="small mt-2" style="color:var(--fedex-purple)">View details <i class="fa fa-arrow-right ms-1"/></div>
            </button>
          </div>
        </t>
      </section>

      <section class="row g-3 mb-4">
        <div class="col-12 col-xl-6">
          <div class="fedex-chart-card h-100">
            <div class="fedex-chart-heading"><div><h4 class="fedex-section-title mb-0">Project pipeline</h4><div class="fedex-chart-subtitle">Distribution by current progress status</div></div><span class="fedex-pill">STATUS</span></div>
            <t t-if="state.data.by_status &amp;&amp; state.data.by_status.length">
              <t t-foreach="chartRows(state.data.by_status,'state')" t-as="r" t-key="r.label">
                <div class="fedex-chart-row"><span><t t-esc="r.label"/></span><div class="fedex-bar"><i t-att-style="'width:'+Math.min(100,(r.count/Math.max(1,state.data.total_projects || state.data.active_projects))*100)+'%'"/></div><b class="fedex-chart-count"><t t-esc="r.count"/></b></div>
              </t>
            </t><t t-else=""><div class="fedex-empty">Project status analytics will appear when project records are available.</div></t>
          </div>
        </div>
        <div class="col-12 col-xl-6">
          <div class="fedex-chart-card h-100">
            <div class="fedex-chart-heading"><div><h4 class="fedex-section-title mb-0">Research categories</h4><div class="fedex-chart-subtitle">Projects grouped by research focus</div></div><span class="fedex-pill">CATEGORY</span></div>
            <t t-if="state.data.by_category &amp;&amp; state.data.by_category.length">
              <t t-foreach="chartRows(state.data.by_category,'category_ids')" t-as="r" t-key="r.label">
                <div class="fedex-chart-row"><span t-att-title="r.label"><t t-esc="r.label"/></span><div class="fedex-bar"><i t-att-style="'width:'+Math.min(100,(r.count/Math.max(1,state.data.total_projects || state.data.active_projects))*100)+'%'"/></div><b class="fedex-chart-count"><t t-esc="r.count"/></b></div>
              </t>
            </t><t t-else=""><div class="fedex-empty">Add categories to projects to populate this view.</div></t>
          </div>
        </div>
        <div class="col-12 col-xl-6">
          <div class="fedex-chart-card h-100">
            <div class="fedex-chart-heading"><div><h4 class="fedex-section-title mb-0">Research verticals</h4><div class="fedex-chart-subtitle">Portfolio distribution across the four verticals</div></div><span class="fedex-pill">VERTICAL</span></div>
            <t t-if="state.data.by_vertical &amp;&amp; state.data.by_vertical.length">
              <t t-foreach="chartRows(state.data.by_vertical,'vertical')" t-as="r" t-key="r.label">
                <div class="fedex-chart-row"><span t-att-title="r.label"><t t-esc="r.label"/></span><div class="fedex-bar"><i t-att-style="'width:'+Math.min(100,(r.count/Math.max(1,state.data.total_projects || state.data.active_projects))*100)+'%'"/></div><b class="fedex-chart-count"><t t-esc="r.count"/></b></div>
              </t>
            </t><t t-else=""><div class="fedex-empty">Choose a research vertical on project records to see this breakdown.</div></t>
          </div>
        </div>
        <div class="col-12 col-xl-6">
          <div class="fedex-chart-card h-100">
            <div class="fedex-chart-heading"><div><h4 class="fedex-section-title mb-0">Project types</h4><div class="fedex-chart-subtitle">Internships, full-time and scholarship work</div></div><span class="fedex-pill">TYPE</span></div>
            <t t-if="state.data.by_type &amp;&amp; state.data.by_type.length">
              <t t-foreach="chartRows(state.data.by_type,'type_id')" t-as="r" t-key="r.label">
                <div class="fedex-chart-row"><span t-att-title="r.label"><t t-esc="r.label"/></span><div class="fedex-bar"><i t-att-style="'width:'+Math.min(100,(r.count/Math.max(1,state.data.total_projects || state.data.active_projects))*100)+'%'"/></div><b class="fedex-chart-count"><t t-esc="r.count"/></b></div>
              </t>
            </t><t t-else=""><div class="fedex-empty">Project type analytics will appear when projects are classified.</div></t>
          </div>
        </div>
      </section>

      <section class="fedex-chart-card mb-3">
        <div class="fedex-chart-heading"><div><h4 class="fedex-section-title mb-0">Recently updated projects</h4><div class="fedex-chart-subtitle">Latest changes visible under your current access rights</div></div><button class="btn btn-secondary btn-sm" t-on-click="()=>open('fedex_repository.action_projects')">All projects <i class="fa fa-arrow-right ms-1"/></button></div>
        <t t-if="state.data.recent &amp;&amp; state.data.recent.length">
          <t t-foreach="state.data.recent" t-as="r" t-key="r.id">
            <div class="fedex-activity-row d-flex justify-content-between align-items-center gap-3">
              <div class="d-flex align-items-center min-w-0">
                <t t-if="r.supervisor_partner_id">
                  <img t-attf-src="/web/image/res.partner/{{r.supervisor_partner_id}}/avatar_128" alt="" class="rounded-circle me-2 flex-shrink-0" style="width:32px;height:32px;object-fit:cover;"/>
                </t>
                <t t-else="">
                  <span class="fedex-activity-dot"/>
                </t>
                <div class="min-w-0">
                  <div class="fw-semibold text-truncate"><t t-esc="r.code"/> <span class="text-muted">·</span> <t t-esc="r.name"/></div>
                  <div class="small text-muted mt-1"><t t-if="r.supervisor_name">Supervisor: <t t-esc="r.supervisor_name"/></t><t t-else="">Research project</t></div>
                </div>
              </div>
              <span t-att-class="'fedex-status-text ' + (r.state === 'completed' ? 'is-completed' : (r.state === 'on_hold' ? 'is-on-hold' : ''))"><t t-esc="r.state_label || r.state"/></span>
            </div>
          </t>
        </t><t t-else=""><div class="fedex-empty">No project activity is available yet. Create a project to begin tracking research.</div></t>
      </section>
      <div class="fedex-dashboard-footer"><span><i class="fa fa-shield me-1"/> Metrics follow your Odoo access permissions.</span><span>FedEx Research Repository <span class="mx-1">·</span> Research operations workspace</span></div>
    </main>
  </t>
  <t t-name="fedex_repository.GlobalSearch">
    <div class="o_fedex_dashboard">
      <section class="fedex-hero p-4 mb-4"><h1 class="mb-2">Find anything.</h1><p class="mb-0">Search across projects, students, faculty, staff and documents.</p></section>
      <div class="fedex-chart-card">
        <div class="input-group"><input class="form-control" t-model="state.q" t-on-keyup="search" placeholder="Search by name, project code or document..." aria-label="Search repository"/><button class="btn btn-primary" t-on-click="search"><i class="fa fa-search me-1"/> Search</button></div>
        <div class="mt-3"><t t-if="state.results.length"><t t-foreach="state.results" t-as="r" t-key="r.model+'-'+r.id"><button class="btn btn-link d-flex align-items-center gap-2 text-start py-2" t-on-click="()=>open(r)"><t t-if="r.avatar_url"><img t-att-src="r.avatar_url" alt="" class="rounded-circle flex-shrink-0" style="width:28px;height:28px;object-fit:cover;"/></t><t t-else=""><i class="fa fa-arrow-up-right-from-square"/></t><span><t t-esc="r.label"/></span></button></t></t><t t-else=""><div class="fedex-empty mt-3">Enter a search term to find repository records.</div></t></div>
      </div>
    </div>
  </t>
</templates>
