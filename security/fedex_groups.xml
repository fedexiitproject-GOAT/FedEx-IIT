<odoo><data noupdate="0">
<record id="module_category_fedex" model="ir.module.category"><field name="name">FedEx Repository</field><field name="sequence">30</field></record>
<record id="group_coordinator" model="res.groups"><field name="name">Coordinator</field><field name="category_id" ref="module_category_fedex"/></record>
<record id="group_repository_manager" model="res.groups"><field name="name">Repository Manager</field><field name="category_id" ref="module_category_fedex"/><field name="implied_ids" eval="[(4, ref('group_coordinator'))]"/></record>
