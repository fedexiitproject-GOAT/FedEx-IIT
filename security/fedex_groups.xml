<record id="group_faculty" model="res.groups"><field name="name">Faculty</field><field name="category_id" ref="module_category_fedex"/></record>
<record id="group_student" model="res.groups"><field name="name">Student</field><field name="category_id" ref="module_category_fedex"/></record>
<record id="group_management" model="res.groups"><field name="name">Management</field><field name="category_id" ref="module_category_fedex"/></record>
</data></odoo>
