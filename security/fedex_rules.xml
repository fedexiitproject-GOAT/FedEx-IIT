    <record id="rule_member_coordinator_centre" model="ir.rule"><field name="name">Coordinator member centre isolation</field><field name="model_id" ref="model_fedex_project_member"/><field name="groups" eval="[(4,ref('group_coordinator'))]"/><field name="domain_force">[('centre_id','in',user.fedex_centre_ids.ids)]</field></record>
