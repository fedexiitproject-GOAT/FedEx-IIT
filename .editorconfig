# EditorConfig is awesome: https://EditorConfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{py,pyw}]
indent_size = 4

[*.{js,ts,jsx,tsx}]
indent_size = 4

[*.{xml,html,xhtml}]
indent_size = 4

[*.{css,scss,sass,less}]
indent_size = 4

[*.{json,yaml,yml}]
indent_size = 2

[*.csv]
indent_style = tab
trim_trailing_whitespace = false

[*.{md,rst}]
trim_trailing_whitespace = false
max_line_length = off
