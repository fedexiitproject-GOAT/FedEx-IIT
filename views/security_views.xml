<odoo><data>
<record id="view_users_form_fedex_centres" model="ir.ui.view"><field name="name">res.users.form.fedex.centres</field><field name="model">res.users</field><field name="inherit_id" ref="base.view_users_form"/><field name="arch" type="xml"><xpath expr="//notebook" position="inside"><page string="FedEx Repository" groups="fedex_repository.group_administrator,fedex_repository.group_repository_manager"><group><field name="fedex_centre_ids" widget="many2many_tags"/></group></page></xpath></field></record>
<record id="view_partner_form_fedex_profiles" model="ir.ui.view"><field name="name">res.partner.form.fedex.profiles</field><field name="model">res.partner</field><field name="inherit_id" ref="base.view_partner_form"/><field name="arch" type="xml"><xpath expr="//div[@name='button_box']" position="inside"><button class="oe_stat_button" type="object" name="action_open_student_profiles" invisible="not is_student"><span class="o_stat_text">Student</span></button><button class="oe_stat_button" type="object" name="action_open_faculty_profiles" invisible="not is_faculty"><span class="o_stat_text">Faculty</span></button><button class="oe_stat_button" type="object" name="action_open_staff_profiles" invisible="not is_staff"><span class="o_stat_text">Staff</span></button></xpath><xpath expr="//field[@name='name']" position="after"><field name="person_type_display" readonly="1"/><field name="is_student" invisible="1"/><field name="is_faculty" invisible="1"/><field name="is_staff" invisible="1"/></xpath></field></record>
</data></odoo>
