<odoo><data>
<record id="view_document_search" model="ir.ui.view"><field name="name">fedex.document.search</field><field name="model">fedex.document</field><field name="arch" type="xml"><search><field name="name"/><field name="filename"/><field name="doc_type_id"/><field name="project_id"/><field name="partner_id"/><field name="member_id"/><filter name="active" string="Active" domain="[('active','=',True)]"/><group expand="0" string="Group By"><filter name="group_by_type" string="Type" context="{'group_by':'doc_type_id'}"/><filter name="group_by_project" string="Project" context="{'group_by':'project_id'}"/><filter name="group_by_uploader" string="Uploader" context="{'group_by':'uploaded_by'}"/></group></search></field></record>
<record id="view_document_list" model="ir.ui.view"><field name="name">fedex.document.list</field><field name="model">fedex.document</field><field name="arch" type="xml"><list><field name="name"/><field name="filename"/><field name="doc_type_id"/><field name="project_id"/><field name="partner_id" widget="many2one_avatar"/><field name="member_id"/><field name="version"/><field name="active"/><field name="uploaded_by" widget="many2one_avatar_user"/><field name="upload_date"/><button name="action_download" type="object" string="Download" icon="fa-download"/></list></field></record>
<record id="view_document_form" model="ir.ui.view"><field name="name">fedex.document.form</field><field name="model">fedex.document</field><field name="arch" type="xml"><form><header><button name="action_replace" type="object" string="Replace File" class="btn-primary" invisible="not active"/><button name="action_download" type="object" string="Download"/><button name="action_preview" type="object" string="Preview" invisible="not active"/></header><sheet><group><group><field name="name"/><field name="doc_type_id"/><field name="version" readonly="1"/><field name="active"/></group><group><field name="project_id" readonly="1"/><field name="partner_id" widget="many2one_avatar" readonly="1"/><field name="member_id" readonly="1"/><field name="uploaded_by" widget="many2one_avatar_user" readonly="1"/><field name="upload_date" readonly="1"/></group></group><group><field name="filename"/><field name="file" filename="filename" widget="pdf_viewer" invisible="not filename or not filename.lower().endswith('.pdf')"/><field name="file" filename="filename" widget="image" invisible="not filename or not (filename.lower().endswith('.png') or filename.lower().endswith('.jpg') or filename.lower().endswith('.jpeg'))"/></group><chatter/></sheet></form></field></record>
<record id="view_requirement_search" model="ir.ui.view"><field name="name">fedex.document.requirement.search</field><field name="model">fedex.document.requirement</field><field name="arch" type="xml"><search><field name="doc_type_id"/><field name="project_id"/><field name="partner_id"/><field name="member_id"/><field name="state"/><filter name="missing" string="Missing" domain="[('active','=',True),('state','=','missing')]"/><filter name="uploaded" string="Uploaded" domain="[('active','=',True),('state','=','uploaded')]"/><group expand="0" string="Group By"><filter name="group_by_project" string="Project" context="{'group_by':'project_id'}"/><filter name="group_by_person" string="Person" context="{'group_by':'partner_id'}"/><filter name="group_by_type" string="Type" context="{'group_by':'doc_type_id'}"/></group></search></field></record>
<record id="view_requirement_list" model="ir.ui.view"><field name="name">fedex.document.requirement.list</field><field name="model">fedex.document.requirement</field><field name="arch" type="xml"><list><field name="doc_type_id"/><field name="project_id"/><field name="partner_id" widget="many2one_avatar"/><field name="member_id"/><field name="document_id"/><field name="state" widget="badge"/><button name="action_upload" type="object" string="Upload" invisible="state != 'missing'"/></list></field></record>
<record id="view_requirement_form" model="ir.ui.view"><field name="name">fedex.document.requirement.form</field><field name="model">fedex.document.requirement</field><field name="arch" type="xml"><form><sheet><group><field name="doc_type_id"/><field name="project_id"/><field name="partner_id" widget="many2one_avatar"/><field name="member_id"/><field name="document_id"/><field name="state" readonly="1"/><field name="active"/><field name="owner_key" readonly="1"/></group></sheet></form></field></record>
</data></odoo>
