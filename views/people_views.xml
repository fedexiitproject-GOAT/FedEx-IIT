<odoo><data>
<record id="view_student_search" model="ir.ui.view"><field name="name">fedex.student.search</field><field name="model">fedex.student</field><field name="arch" type="xml"><search><field name="student_code"/><field name="name"/><field name="email"/><field name="status"/><field name="institution_id"/><field name="department_id"/><filter name="active" string="Active" domain="[('active','=',True)]"/><filter name="missing" string="Missing Documents" domain="[('missing_doc_count','>',0)]"/><group expand="0" string="Group By"><filter name="group_by_status" string="Status" context="{'group_by':'status'}"/><filter name="group_by_institution" string="Institution" context="{'group_by':'institution_id'}"/></group></search></field></record>
<record id="view_student_list" model="ir.ui.view"><field name="name">fedex.student.list</field><field name="model">fedex.student</field><field name="arch" type="xml"><list><field name="avatar_128" widget="image" string="Photo" options="{'size': [32, 32]}" width="48px"/><field name="student_code"/><field name="name"/><field name="email"/><field name="degree_id"/><field name="institution_id"/><field name="department_id"/><field name="status" widget="badge"/><field name="missing_doc_count"/></list></field></record>
<record id="view_student_kanban" model="ir.ui.view"><field name="name">fedex.student.kanban</field><field name="model">fedex.student</field><field name="arch" type="xml"><kanban><field name="id"/><field name="partner_id"/><field name="avatar_128"/><field name="student_code"/><field name="name"/><field name="email"/><field name="degree_id"/><field name="institution_id"/><field name="status"/><templates><t t-name="card"><div class="oe_kanban_card p-3 d-flex align-items-center gap-3"><div class="flex-shrink-0"><field name="avatar_128" widget="image" options="{'size': [64, 64]}" class="rounded-circle overflow-hidden"/></div><div class="min-w-0 flex-grow-1"><div class="fw-bold text-truncate"><field name="name"/></div><div class="text-muted small"><field name="student_code"/></div><div class="small text-truncate mt-1"><field name="degree_id"/> · <field name="institution_id"/></div><div class="mt-1"><field name="status" widget="badge"/></div></div></div></t></templates></kanban></field></record>
<record id="view_student_form" model="ir.ui.view"><field name="name">fedex.student.form</field><field name="model">fedex.student</field><field name="arch" type="xml"><form><header/><sheet><div class="oe_button_box"><button class="oe_stat_button" type="object" name="action_open_projects"><field name="project_count" widget="statinfo" string="Projects"/></button><button class="oe_stat_button"><field name="missing_doc_count" widget="statinfo" string="Missing Docs"/></button></div><field name="avatar_128" invisible="1"/><field name="partner_id" invisible="1" required="0"/><field name="image_1920" widget="image" class="oe_avatar" options="{'preview_image': 'avatar_128'}"/><group><group><field name="student_code" readonly="1"/><field name="name"/><field name="email"/><field name="phone"/></group><group><field name="degree_id"/><field name="institution_id"/><field name="department_id" domain="[('institution_id','=',institution_id)]"/><field name="year_of_study"/><field name="grading_scale"/><field name="cgpa"/><field name="status"/></group></group><notebook><page string="Skills"><group><field name="technical_skill_ids" widget="many2many_tags"/><field name="soft_skill_ids" widget="many2many_tags"/><field name="domain_ids" widget="many2many_tags"/></group></page><page string="Projects"><field name="member_ids" readonly="1"><list><field name="project_id"/><field name="role_id"/><field name="start_date"/><field name="expected_end_date"/><field name="state"/></list></field></page><page string="Documents"><field name="requirement_ids" domain="[('active','=',True)]"><list><field name="doc_type_id"/><field name="state" widget="badge"/><field name="document_id"/><button name="action_upload" type="object" string="Upload" invisible="state != 'missing'"/></list></field></page></notebook><chatter/></sheet></form></field></record>

