<odoo><data>
<record id="view_member_search" model="ir.ui.view"><field name="name">fedex.project.member.search</field><field name="model">fedex.project.member</field><field name="arch" type="xml"><search><field name="project_id"/><field name="partner_id"/><field name="role_id"/><field name="state"/><field name="centre_id"/><filter name="active" string="Active" domain="[('state','=','active')]"/><filter name="internships" string="Internships" domain="[('is_internship','=',True)]"/><group expand="0" string="Group By"><filter name="group_by_project" string="Project" context="{'group_by':'project_id'}"/><filter name="group_by_role" string="Role" context="{'group_by':'role_id'}"/><filter name="group_by_person_type" string="Person Type" context="{'group_by':'person_type_display'}"/></group></search></field></record>
<record id="view_member_list" model="ir.ui.view"><field name="name">fedex.project.member.list</field><field name="model">fedex.project.member</field><field name="arch" type="xml"><list><field name="project_id"/><field name="partner_id" widget="many2one_avatar"/><field name="person_type_display"/><field name="role_id"/><field name="start_date"/><field name="expected_end_date"/><field name="state"/><field name="certificate_issued"/></list></field></record>
<record id="view_member_form" model="ir.ui.view"><field name="name">fedex.project.member.form</field><field name="model">fedex.project.member</field><field name="arch" type="xml"><form><sheet><group><field name="project_id"/><field name="partner_id" widget="many2one_avatar"/><field name="role_id"/><field name="person_type_display" readonly="1"/><field name="start_date"/><field name="expected_end_date"/><field name="actual_end_date"/><field name="state"/><field name="certificate_issued"/></group><notebook><page string="Documents"><field name="requirement_ids"><list><field name="doc_type_id"/><field name="state" widget="badge"/><field name="document_id"/><button name="action_upload" type="object" string="Upload" invisible="state != 'missing'"/></list></field></page></notebook></sheet></form></field></record>
<record id="view_milestone_search" model="ir.ui.view"><field name="name">fedex.milestone.search</field><field name="model">fedex.milestone</field><field name="arch" type="xml"><search><field name="project_id"/><field name="name"/><field name="state"/><filter name="overdue" string="Overdue" domain="[('state','=','overdue')]"/><group expand="0" string="Group By"><filter name="group_by_project" string="Project" context="{'group_by':'project_id'}"/><filter name="group_by_state" string="Completed" context="{'group_by':'done'}"/></group></search></field></record>
<record id="view_milestone_list" model="ir.ui.view"><field name="name">fedex.milestone.list</field><field name="model">fedex.milestone</field><field name="arch" type="xml"><list><field name="project_id"/><field name="name"/><field name="due_date"/><field name="done"/><field name="state" widget="badge"/></list></field></record>
<record id="view_milestone_form" model="ir.ui.view"><field name="name">fedex.milestone.form</field><field name="model">fedex.milestone</field><field name="arch" type="xml"><form><sheet><group><field name="project_id"/><field name="name"/><field name="due_date"/><field name="done"/><field name="state" readonly="1"/></group></sheet></form></field></record>

<record id="action_project_members" model="ir.actions.act_window"><field name="name">Project Personnel</field><field name="res_model">fedex.project.member</field><field name="view_mode">list,form</field><field name="domain">[('project_id','=',active_id)]</field><field name="search_view_id" ref="view_member_search"/></record>
<record id="action_project_documents" model="ir.actions.act_window"><field name="name">Project Documents</field><field name="res_model">fedex.document.requirement</field><field name="view_mode">list,form</field><field name="domain">[('project_id','=',active_id),('active','=',True)]</field><field name="search_view_id" ref="view_requirement_search"/></record>
<record id="action_project_milestones" model="ir.actions.act_window"><field name="name">Project Milestones</field><field name="res_model">fedex.milestone</field><field name="view_mode">list,form</field><field name="domain">[('project_id','=',active_id)]</field><field name="search_view_id" ref="view_milestone_search"/></record>

<record id="view_project_search" model="ir.ui.view"><field name="name">fedex.project.search</field><field name="model">fedex.project</field><field name="arch" type="xml"><search><field name="code"/><field name="name"/><field name="centre_id"/><field name="type_id"/><field name="category_ids"/><field name="sponsor_id"/><field name="supervisor_id"/><field name="state"/><field name="priority"/><filter name="active" string="Active" domain="[('active','=',True)]"/><filter name="in_progress" string="In Progress" domain="[('state','=','in_progress')]"/><filter name="nearing" string="Nearing Completion" domain="[('is_nearing_completion','=',True)]"/><filter name="missing" string="Missing Documents" domain="[('missing_doc_count','>',0)]"/><group expand="0" string="Group By"><filter name="group_by_state" string="State" context="{'group_by':'state'}"/><filter name="group_by_centre" string="Centre" context="{'group_by':'centre_id'}"/><filter name="group_by_category" string="Category" context="{'group_by':'category_ids'}"/><filter name="group_by_sponsor" string="Sponsor" context="{'group_by':'sponsor_id'}"/></group></search></field></record>
<record id="view_project_list" model="ir.ui.view"><field name="name">fedex.project.list</field><field name="model">fedex.project</field><field name="arch" type="xml"><list><field name="code"/><field name="name"/><field name="centre_id"/><field name="type_id"/><field name="supervisor_id" widget="many2one_avatar"/><field name="state"/><field name="priority"/><field name="progress" widget="progressbar"/><field name="days_remaining"/><field name="missing_doc_count"/></list></field></record>
<record id="view_project_kanban" model="ir.ui.view"><field name="name">fedex.project.kanban</field><field name="model">fedex.project</field><field name="arch" type="xml"><kanban default_group_by="state"><field name="name"/><field name="code"/><field name="state"/><field name="priority"/><field name="supervisor_id"/><field name="progress"/><field name="missing_doc_count"/><templates><t t-name="card"><div class="oe_kanban_card p-3"><strong><field name="code"/> · <field name="name"/></strong><div class="mt-2"><field name="supervisor_id" widget="many2one_avatar"/></div><div class="mt-2"><field name="progress" widget="progressbar"/></div><div class="mt-2">Priority: <field name="priority"/></div><div t-if="record.missing_doc_count.raw_value" class="text-danger mt-1">Missing: <field name="missing_doc_count"/> documents</div></div></t></templates></kanban></field></record>
<record id="view_project_form" model="ir.ui.view"><field name="name">fedex.project.form</field><field name="model">fedex.project</field><field name="arch" type="xml"><form><header><button name="action_mark_completed" type="object" string="Mark Completed" class="btn-primary" invisible="state == 'completed'"/><button name="action_add_members" type="object" string="Add Members" class="btn-secondary"/><field name="state" widget="statusbar" statusbar_visible="new_project,yet_to_start,in_progress,on_hold,completed,cancelled"/><field name="priority"/></header><sheet><div class="oe_button_box" name="button_box"><button class="oe_stat_button" type="action" name="%(action_project_members)d"><field name="member_count" widget="statinfo" string="Members"/></button><button class="oe_stat_button" type="action" name="%(action_project_documents)d"><field name="missing_doc_count" widget="statinfo" string="Documents"/></button><button class="oe_stat_button" type="action" name="%(action_project_milestones)d"><field name="milestone_count" widget="statinfo" string="Milestones"/></button></div><div class="oe_title"><label for="name"/><h1><field name="name"/></h1><field name="code" readonly="1"/></div><group><group><field name="centre_id"/><field name="type_id"/><field name="category_ids" widget="many2many_tags"/><field name="sponsor_id"/><field name="supervisor_id" widget="many2one_avatar"/></group><group><field name="start_date"/><field name="expected_end_date"/><field name="actual_end_date"/><field name="days_remaining" readonly="1"/><field name="progress" widget="progressbar"/><field name="member_count" readonly="1"/><field name="milestone_done_count" readonly="1"/><field name="milestone_count" readonly="1"/></group></group><notebook><page string="Team"><field name="member_ids"><list editable="bottom"><field name="partner_id" widget="many2one_avatar"/><field name="role_id"/><field name="start_date"/><field name="expected_end_date"/><field name="actual_end_date"/><field name="state"/><field name="certificate_issued"/></list></field></page><page string="Documents"><field name="requirement_ids" domain="[('active','=',True)]"><list><field name="doc_type_id"/><field name="state" widget="badge"/><field name="document_id"/><button name="action_upload" type="object" string="Upload" invisible="state != 'missing'"/></list></field></page><page string="Milestones"><field name="milestone_ids"><list editable="bottom"><field name="name"/><field name="due_date"/><field name="done"/><field name="state"/></list></field></page><page string="Description"><field name="description" nolabel="1"/></page></notebook><chatter/></sheet></form></field></record>
</data></odoo>
