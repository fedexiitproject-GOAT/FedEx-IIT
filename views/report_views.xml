<odoo><data>
<record id="view_report_project_search" model="ir.ui.view"><field name="name">fedex.project.report.search</field><field name="model">fedex.project</field><field name="arch" type="xml"><search><field name="code"/><field name="name"/><field name="centre_id"/><field name="category_ids"/><field name="sponsor_id"/><field name="state"/><filter name="in_progress" string="In Progress" domain="[('state','=','in_progress')]"/><filter name="nearing" string="Nearing Completion" domain="[('is_nearing_completion','=',True)]"/><group expand="0" string="Group By"><filter name="group_by_state" string="State" context="{'group_by':'state'}"/><filter name="group_by_category" string="Category" context="{'group_by':'category_ids'}"/><filter name="group_by_sponsor" string="Sponsor" context="{'group_by':'sponsor_id'}"/><filter name="group_by_centre" string="Centre" context="{'group_by':'centre_id'}"/></group></search></field></record>
<record id="view_report_project_list" model="ir.ui.view"><field name="name">fedex.project.report.list</field><field name="model">fedex.project</field><field name="arch" type="xml"><list><field name="code"/><field name="name"/><field name="centre_id"/><field name="type_id"/><field name="category_ids"/><field name="sponsor_id"/><field name="supervisor_id" widget="many2one_avatar"/><field name="state"/><field name="progress"/><field name="days_remaining"/></list></field></record>
<record id="view_report_category_pivot" model="ir.ui.view"><field name="name">fedex.report.category.pivot</field><field name="model">fedex.project</field><field name="arch" type="xml"><pivot string="Projects by Category"><field name="category_ids" type="row"/><field name="state" type="col"/></pivot></field></record>
<record id="view_report_category_graph" model="ir.ui.view"><field name="name">fedex.report.category.graph</field><field name="model">fedex.project</field><field name="arch" type="xml"><graph string="Projects by Category" type="bar"><field name="category_ids" type="row"/></graph></field></record>
<record id="view_report_sponsor_pivot" model="ir.ui.view"><field name="name">fedex.report.sponsor.pivot</field><field name="model">fedex.project</field><field name="arch" type="xml"><pivot string="Projects by Sponsor"><field name="sponsor_id" type="row"/><field name="state" type="col"/></pivot></field></record>
<record id="view_report_sponsor_graph" model="ir.ui.view"><field name="name">fedex.report.sponsor.graph</field><field name="model">fedex.project</field><field name="arch" type="xml"><graph string="Projects by Sponsor" type="bar"><field name="sponsor_id" type="row"/></graph></field></record>
<record id="view_report_nearing_pivot" model="ir.ui.view"><field name="name">fedex.report.nearing.pivot</field><field name="model">fedex.project</field><field name="arch" type="xml"><pivot string="Projects by Centre"><field name="centre_id" type="row"/><field name="state" type="col"/></pivot></field></record>
<record id="view_report_nearing_graph" model="ir.ui.view"><field name="name">fedex.report.nearing.graph</field><field name="model">fedex.project</field><field name="arch" type="xml"><graph string="Projects by Centre" type="bar"><field name="centre_id" type="row"/></graph></field></record>

<record id="view_report_member_search" model="ir.ui.view"><field name="name">fedex.member.report.search</field><field name="model">fedex.project.member</field><field name="arch" type="xml"><search><field name="project_id"/><field name="partner_id"/><field name="role_id"/><field name="state"/><field name="centre_id"/><filter name="internships" string="Internships" domain="[('is_internship','=',True)]"/><group expand="0" string="Group By"><filter name="group_by_project" string="Project" context="{'group_by':'project_id'}"/><filter name="group_by_role" string="Role" context="{'group_by':'role_id'}"/><filter name="group_by_person_type" string="Person Type" context="{'group_by':'person_type_display'}"/></group></search></field></record>
<record id="view_report_member_list" model="ir.ui.view"><field name="name">fedex.member.report.list</field><field name="model">fedex.project.member</field><field name="arch" type="xml"><list><field name="project_id"/><field name="partner_id" widget="many2one_avatar"/><field name="person_type_display"/><field name="role_id"/><field name="start_date"/><field name="expected_end_date"/><field name="state"/><field name="certificate_issued"/></list></field></record>
<record id="view_report_member_pivot" model="ir.ui.view"><field name="name">fedex.member.report.pivot</field><field name="model">fedex.project.member</field><field name="arch" type="xml"><pivot string="Project Personnel"><field name="project_id" type="row"/><field name="role_id" type="row"/><field name="person_type_display" type="col"/></pivot></field></record>
<record id="view_report_member_graph" model="ir.ui.view"><field name="name">fedex.member.report.graph</field><field name="model">fedex.project.member</field><field name="arch" type="xml"><graph string="Project Personnel" type="bar"><field name="role_id" type="row"/></graph></field></record>

<record id="view_report_requirement_search" model="ir.ui.view"><field name="name">fedex.requirement.report.search</field><field name="model">fedex.document.requirement</field><field name="arch" type="xml"><search><field name="project_id"/><field name="partner_id"/><field name="doc_type_id"/><field name="state"/><filter name="missing" string="Missing" domain="[('active','=',True),('state','=','missing')]"/><group expand="0" string="Group By"><filter name="group_by_project" string="Project" context="{'group_by':'project_id'}"/><filter name="group_by_person" string="Person" context="{'group_by':'partner_id'}"/><filter name="group_by_type" string="Type" context="{'group_by':'doc_type_id'}"/></group></search></field></record>
<record id="view_report_requirement_list" model="ir.ui.view"><field name="name">fedex.requirement.report.list</field><field name="model">fedex.document.requirement</field><field name="arch" type="xml"><list><field name="doc_type_id"/><field name="project_id"/><field name="partner_id" widget="many2one_avatar"/><field name="member_id"/><field name="document_id"/><field name="state"/></list></field></record>
<record id="view_report_requirement_pivot" model="ir.ui.view"><field name="name">fedex.requirement.report.pivot</field><field name="model">fedex.document.requirement</field><field name="arch" type="xml"><pivot string="Document Requirements"><field name="project_id" type="row"/><field name="partner_id" type="row"/><field name="state" type="col"/></pivot></field></record>
<record id="view_report_requirement_graph" model="ir.ui.view"><field name="name">fedex.requirement.report.graph</field><field name="model">fedex.document.requirement</field><field name="arch" type="xml"><graph string="Document Requirements" type="bar"><field name="state" type="row"/></graph></field></record>

<record id="action_active_projects" model="ir.actions.act_window"><field name="name">Active Projects</field><field name="res_model">fedex.project</field><field name="view_mode">list,pivot,graph</field><field name="domain">[('state','=','in_progress')]</field><field name="search_view_id" ref="view_report_project_search"/></record>
<record id="action_category_projects" model="ir.actions.act_window"><field name="name">Projects by Category</field><field name="res_model">fedex.project</field><field name="view_mode">list,pivot,graph</field><field name="search_view_id" ref="view_report_project_search"/></record>
<record id="action_sponsor_projects" model="ir.actions.act_window"><field name="name">Projects by Sponsor</field><field name="res_model">fedex.project</field><field name="view_mode">list,pivot,graph</field><field name="search_view_id" ref="view_report_project_search"/></record>
<record id="action_project_personnel_report" model="ir.actions.act_window"><field name="name">Project Personnel</field><field name="res_model">fedex.project.member</field><field name="view_mode">list,pivot,graph</field><field name="search_view_id" ref="view_report_member_search"/></record>
<record id="action_nearing_projects" model="ir.actions.act_window"><field name="name">Projects Nearing Completion</field><field name="res_model">fedex.project</field><field name="view_mode">list,pivot,graph</field><field name="domain">[('is_nearing_completion','=',True)]</field><field name="search_view_id" ref="view_report_project_search"/></record>
<record id="action_pending_documents" model="ir.actions.act_window"><field name="name">Pending Documents</field><field name="res_model">fedex.document.requirement</field><field name="view_mode">list,pivot,graph</field><field name="domain">[('active','=',True),('state','=','missing')]</field><field name="search_view_id" ref="view_report_requirement_search"/></record>
<record id="action_internship" model="ir.actions.act_window"><field name="name">Internship Information</field><field name="res_model">fedex.project.member</field><field name="view_mode">list,pivot,graph</field><field name="domain">[('is_internship','=',True)]</field><field name="search_view_id" ref="view_report_member_search"/></record>

<record id="action_active_projects_view_list" model="ir.actions.act_window.view"><field name="sequence">1</field><field name="view_mode">list</field><field name="view_id" ref="view_report_project_list"/><field name="act_window_id" ref="action_active_projects"/></record>
<record id="action_active_projects_view_pivot" model="ir.actions.act_window.view"><field name="sequence">2</field><field name="view_mode">pivot</field><field name="view_id" ref="view_report_nearing_pivot"/><field name="act_window_id" ref="action_active_projects"/></record>
<record id="action_active_projects_view_graph" model="ir.actions.act_window.view"><field name="sequence">3</field><field name="view_mode">graph</field><field name="view_id" ref="view_report_nearing_graph"/><field name="act_window_id" ref="action_active_projects"/></record>
<record id="action_category_projects_view_list" model="ir.actions.act_window.view"><field name="sequence">1</field><field name="view_mode">list</field><field name="view_id" ref="view_report_project_list"/><field name="act_window_id" ref="action_category_projects"/></record>
<record id="action_category_projects_view_pivot" model="ir.actions.act_window.view"><field name="sequence">2</field><field name="view_mode">pivot</field><field name="view_id" ref="view_report_category_pivot"/><field name="act_window_id" ref="action_category_projects"/></record>
<record id="action_category_projects_view_graph" model="ir.actions.act_window.view"><field name="sequence">3</field><field name="view_mode">graph</field><field name="view_id" ref="view_report_category_graph"/><field name="act_window_id" ref="action_category_projects"/></record>
<record id="action_sponsor_projects_view_list" model="ir.actions.act_window.view"><field name="sequence">1</field><field name="view_mode">list</field><field name="view_id" ref="view_report_project_list"/><field name="act_window_id" ref="action_sponsor_projects"/></record>
<record id="action_sponsor_projects_view_pivot" model="ir.actions.act_window.view"><field name="sequence">2</field><field name="view_mode">pivot</field><field name="view_id" ref="view_report_sponsor_pivot"/><field name="act_window_id" ref="action_sponsor_projects"/></record>
<record id="action_sponsor_projects_view_graph" model="ir.actions.act_window.view"><field name="sequence">3</field><field name="view_mode">graph</field><field name="view_id" ref="view_report_sponsor_graph"/><field name="act_window_id" ref="action_sponsor_projects"/></record>
<record id="action_nearing_projects_view_list" model="ir.actions.act_window.view"><field name="sequence">1</field><field name="view_mode">list</field><field name="view_id" ref="view_report_project_list"/><field name="act_window_id" ref="action_nearing_projects"/></record>
<record id="action_nearing_projects_view_pivot" model="ir.actions.act_window.view"><field name="sequence">2</field><field name="view_mode">pivot</field><field name="view_id" ref="view_report_nearing_pivot"/><field name="act_window_id" ref="action_nearing_projects"/></record>
<record id="action_nearing_projects_view_graph" model="ir.actions.act_window.view"><field name="sequence">3</field><field name="view_mode">graph</field><field name="view_id" ref="view_report_nearing_graph"/><field name="act_window_id" ref="action_nearing_projects"/></record>
<record id="action_project_personnel_report_view_list" model="ir.actions.act_window.view"><field name="sequence">1</field><field name="view_mode">list</field><field name="view_id" ref="view_report_member_list"/><field name="act_window_id" ref="action_project_personnel_report"/></record>
<record id="action_project_personnel_report_view_pivot" model="ir.actions.act_window.view"><field name="sequence">2</field><field name="view_mode">pivot</field><field name="view_id" ref="view_report_member_pivot"/><field name="act_window_id" ref="action_project_personnel_report"/></record>
<record id="action_project_personnel_report_view_graph" model="ir.actions.act_window.view"><field name="sequence">3</field><field name="view_mode">graph</field><field name="view_id" ref="view_report_member_graph"/><field name="act_window_id" ref="action_project_personnel_report"/></record>
<record id="action_internship_view_list" model="ir.actions.act_window.view"><field name="sequence">1</field><field name="view_mode">list</field><field name="view_id" ref="view_report_member_list"/><field name="act_window_id" ref="action_internship"/></record>
<record id="action_internship_view_pivot" model="ir.actions.act_window.view"><field name="sequence">2</field><field name="view_mode">pivot</field><field name="view_id" ref="view_report_member_pivot"/><field name="act_window_id" ref="action_internship"/></record>
<record id="action_internship_view_graph" model="ir.actions.act_window.view"><field name="sequence">3</field><field name="view_mode">graph</field><field name="view_id" ref="view_report_member_graph"/><field name="act_window_id" ref="action_internship"/></record>
<record id="action_pending_documents_view_list" model="ir.actions.act_window.view"><field name="sequence">1</field><field name="view_mode">list</field><field name="view_id" ref="view_report_requirement_list"/><field name="act_window_id" ref="action_pending_documents"/></record>
<record id="action_pending_documents_view_pivot" model="ir.actions.act_window.view"><field name="sequence">2</field><field name="view_mode">pivot</field><field name="view_id" ref="view_report_requirement_pivot"/><field name="act_window_id" ref="action_pending_documents"/></record>
<record id="action_pending_documents_view_graph" model="ir.actions.act_window.view"><field name="sequence">3</field><field name="view_mode">graph</field><field name="view_id" ref="view_report_requirement_graph"/><field name="act_window_id" ref="action_pending_documents"/></record>
</data></odoo>
