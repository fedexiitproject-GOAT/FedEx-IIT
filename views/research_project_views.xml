<odoo>
  <record id="view_project_form_research_extension" model="ir.ui.view">
    <field name="name">fedex.project.form.research.extension</field>
    <field name="model">fedex.project</field>
    <field name="inherit_id" ref="fedex_repository.view_project_form"/>
    <field name="arch" type="xml">
      <xpath expr="//div[contains(@class,'oe_title')]" position="after">
        <group string="Research Profile" col="4" class="o_fedex_glass_panel">
          <field name="vertical"/>
        </group>
      </xpath>
      <xpath expr="//notebook" position="inside">
        <page string="Research Details" name="research_details">
          <group>
            <group string="About"><field name="about" nolabel="1" placeholder="Purpose and context of this project..."/></group>
            <group string="Overview"><field name="overview" nolabel="1" placeholder="A concise overview..."/></group>
          </group>
          <group>
            <group string="Objectives"><field name="objectives" nolabel="1" placeholder="Objectives and expected outcomes..."/></group>
            <group string="Methodology"><field name="methodology" nolabel="1" placeholder="Research approach and methods..."/></group>
          </group>
          <group string="Progress and Next Step">
            <field name="progress" widget="progressbar"/>
            <field name="next_step" placeholder="Next planned milestone or action..."/>
          </group>
          <group string="Research Team">
            <field name="member_ids">
              <list editable="bottom">
                <field name="partner_id" widget="many2one_avatar"/><field name="role_id"/><field name="association_type"/>
                <field name="start_date"/><field name="expected_end_date"/><field name="state"/>
              </list>
            </field>
          </group>
        </page>
      </xpath>
    </field>
  </record>
  <record id="view_project_list_research_extension" model="ir.ui.view">
    <field name="name">fedex.project.list.research.extension</field>
    <field name="model">fedex.project</field>
    <field name="inherit_id" ref="fedex_repository.view_project_list"/>
    <field name="arch" type="xml">
      <xpath expr="//field[@name='type_id']" position="after"><field name="vertical"/></xpath>
    </field>
  </record>
  <record id="view_member_form_association_extension" model="ir.ui.view">
    <field name="name">fedex.project.member.form.association.extension</field>
    <field name="model">fedex.project.member</field>
    <field name="inherit_id" ref="fedex_repository.view_member_form"/>
    <field name="arch" type="xml">
      <xpath expr="//field[@name='role_id']" position="after"><field name="association_type"/></xpath>
    </field>
  </record>
  <record id="view_partner_form_people_role_extension" model="ir.ui.view">
    <field name="name">res.partner.form.fedex.people.role.extension</field>
    <field name="model">res.partner</field>
    <field name="inherit_id" ref="base.view_partner_form"/>
    <field name="arch" type="xml">
      <xpath expr="//sheet//group" position="inside">
        <field name="people_role" groups="fedex_repository.group_repository_manager,fedex_repository.group_administrator"/>
      </xpath>
    </field>
  </record>

  <record id="view_project_search_research_extension" model="ir.ui.view">
    <field name="name">fedex.project.search.research.extension</field>
    <field name="model">fedex.project</field>
    <field name="inherit_id" ref="fedex_repository.view_project_search"/>
    <field name="arch" type="xml">
      <xpath expr="//search/field[@name='state']" position="after"><field name="vertical"/></xpath>
      <xpath expr="//search/group" position="inside"><filter string="Research Vertical" name="group_research_vertical" context="{'group_by':'vertical'}"/><filter string="Project Type" name="group_research_type" context="{'group_by':'type_id'}"/></xpath>
    </field>
  </record>
  <record id="view_student_form_people_role_extension" model="ir.ui.view">
    <field name="name">fedex.student.form.people.role.extension</field>
    <field name="model">fedex.student</field>
    <field name="inherit_id" ref="fedex_repository.view_student_form"/>
    <field name="arch" type="xml"><xpath expr="//field[@name='email']" position="after"><field name="people_role" groups="fedex_repository.group_repository_manager,fedex_repository.group_administrator"/></xpath></field>
  </record>
  <record id="view_faculty_form_people_role_extension" model="ir.ui.view">
    <field name="name">fedex.faculty.form.people.role.extension</field>
    <field name="model">fedex.faculty</field>
    <field name="inherit_id" ref="fedex_repository.view_faculty_form"/>
    <field name="arch" type="xml"><xpath expr="//field[@name='email']" position="after"><field name="people_role" groups="fedex_repository.group_repository_manager,fedex_repository.group_administrator"/></xpath></field>
  </record>
  <record id="view_staff_form_people_role_extension" model="ir.ui.view">
    <field name="name">fedex.staff.form.people.role.extension</field>
    <field name="model">fedex.staff</field>
    <field name="inherit_id" ref="fedex_repository.view_staff_form"/>
    <field name="arch" type="xml"><xpath expr="//field[@name='email']" position="after"><field name="people_role" groups="fedex_repository.group_repository_manager,fedex_repository.group_administrator"/></xpath></field>
  </record>

</odoo>